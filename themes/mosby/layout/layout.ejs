<!DOCTYPE html>
<html lang="<%= config.language %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><% if (is_home()) { %><%= config.title %><% } else { %><%= page.title %> · <%= config.title %><% } %></title>
  <%- open_graph({}) %>
  <%- css('css/style.css') %>
  <%- js('js/lang.js') %>
</head>
<body>
  <aside class="sidebar" aria-label="导航侧边栏">
    <div class="sidebar-inner">
      <a class="logo" href="<%= url_for('/') %>"><%= config.title %></a>

      <nav class="sidebar-nav">
        <% var menuKeys = { '首页':'nav.home', '日记':'nav.diary', '杂谈':'nav.essay', '开发':'nav.dev', '归档':'nav.archive', '标签':'nav.tags', '关于':'nav.about' }; %>
        <% for (var name in theme.menu) { %>
          <a class="sidebar-link<%= is_current(theme.menu[name]) ? ' active' : '' %>" href="<%= url_for(theme.menu[name]) %>" data-i18n="<%= menuKeys[name] || 'nav.home' %>"><%= name %></a>
        <% } %>
      </nav>

      <div class="sidebar-foot">
        <span data-i18n="footer"><%= theme.footer %></span>
        <%- partial('_partial/lang-switcher', { modifier: 'sidebar' }) %>
      </div>
    </div>
  </aside>

  <header class="site-header">
    <div class="header-inner">
      <%- partial('_partial/lang-switcher', { modifier: 'header' }) %>
      <a class="profile" href="<%= theme.author.url %>" target="_blank" rel="noopener">
        <img class="profile-avatar" src="<%= theme.author.avatar %>" alt="<%= theme.author.name %> 的头像" loading="lazy">
        <span class="profile-name"><%= theme.author.name %></span>
      </a>
    </div>
  </header>

  <main class="main">
    <%- body %>
  </main>

  <footer class="site-footer">
    <div class="footer-inner"><span data-i18n="footer"><%= theme.footer %></span></div>
  </footer>
</body>
</html>
