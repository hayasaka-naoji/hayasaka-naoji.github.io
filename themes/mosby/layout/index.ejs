<section class="hero">
  <p class="hero-tag">PROJECT ARCHIVE</p>
  <h1 class="hero-title"><%= config.title %></h1>
  <p class="hero-sub"><%= theme.tagline || config.subtitle || '' %></p>
</section>

<section class="grid">
  <% page.posts.each(function(post){ %>
    <a class="card" href="<%= url_for(post.path) %>">
      <div class="card-meta">
        <span class="card-date"><%= date(post.date, 'YYYY.MM.DD') %></span>
        <% if (post.tags && post.tags.length){ %>
          <span class="card-tags">
            <% post.tags.each(function(tag){ %>
              <span class="tag"><%= tag.name %></span>
            <% }) %>
          </span>
        <% } %>
      </div>
      <h2 class="card-title"><%= post.title %></h2>
      <% if (post.excerpt){ %>
        <p class="card-excerpt"><%= post.excerpt %></p>
      <% } %>
    </a>
  <% }) %>
</section>

<% if (page.total > 1){ %>
<nav class="pagination">
  <% if (page.prev){ %><a class="page-link" href="<%= url_for(page.prev_link) %>">← 上一页</a><% } %>
  <% if (page.next){ %><a class="page-link" href="<%= url_for(page.next_link) %>">下一页 →</a><% } %>
</nav>
<% } %>
