<section class="hero">
  <p class="hero-tag">HAYASAKA NAOJI</p>
  <h1 class="hero-title"><%= config.title %></h1>
  <p class="hero-sub" data-i18n="tagline"><%= theme.tagline || config.subtitle || '' %></p>
</section>

<section class="intro">
  <p data-i18n="intro">这里是我的自留地：写点日记，偶尔杂谈，也记录开发时的折腾。不追热点，不赶节奏，只是安静地写。</p>
</section>

<section class="columns">
  <% var colKeys = { '日记':'col.diary', '杂谈':'col.essay', '开发':'col.dev' }; %>
  <% (theme.columns || []).forEach(function(col){ %>
    <a class="column-card" href="<%= url_for(col.path) %>">
      <div class="column-rule"></div>
      <h2 class="column-name" data-i18n="<%= colKeys[col.name] ? colKeys[col.name] + '.name' : '' %>"><%= col.name %></h2>
      <p class="column-desc" data-i18n="<%= colKeys[col.name] ? colKeys[col.name] + '.desc' : '' %>"><%= col.desc %></p>
    </a>
  <% }) %>
</section>

<section class="stats">
  <div class="stat"><span class="stat-num"><%= site.posts.length %></span><span class="stat-label" data-i18n="stat.posts">篇文章</span></div>
  <div class="stat"><span class="stat-num"><%= site.tags.length %></span><span class="stat-label" data-i18n="stat.tags">个标签</span></div>
  <div class="stat"><span class="stat-num"><%= site.categories.length %></span><span class="stat-label" data-i18n="stat.categories">个专栏</span></div>
</section>
